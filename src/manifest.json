{
    "manifest_version": 3,
    "name": "GitBell",
    "version": "2.0.0",
    "description": "Never miss a GitHub issue again! Perfect for GSoC contributors.",
    "permissions": [
        "storage",
        "alarms",
        "notifications"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "background": {
        "service_worker": "src/background/index.js",
        "type": "module"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}